# We're going to need UTF-8, badly
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8


# chezmoi installs the zsh components into this folder
ZSH_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"

# .localrc is a place to put host specific stuff
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# ZSH options
# http://zsh.sourceforge.net/Doc/Release/Options.html
setopt globdots     # Enable globbing for hidden files
setopt extendedglob # advanced globbing
setopt multios      # enable piping to multiple outputs
setopt auto_cd      # automatically cd into directories when typing their name
setopt cdable_vars  # try to expand the expression as if it were preceded by a ‘~’
setopt auto_pushd   # make cd push the old directory onto the directory stack
setopt correct      # try to correct the spelling of commands


# Load all dotfile components in 3 steps
# Component names: <topic>.env.zsh, <topic>.completion.zsh, <name>.zsh
typeset -U config_files
config_files=($ZSH_CONFIG_DIR/*.zsh(N))

# 1. load envs (exports and stuff)
source $ZSH_CONFIG_DIR/homebrew.env.zsh

# homebrew.env.zsh is already loaded above, so skip it here
for file in ${${(M)config_files:#*.env.zsh}:#*/homebrew.env.zsh}
do
  source $file
done

# 2. load everything but envs and completions
for file in ${${config_files:#*.env.zsh}:#*.completion.zsh}
do
  source $file
done

# initialize autocomplete here, otherwise functions won't be loaded
# Do the full (slow) security check at most one time each day.
# Other shells use the dump with -C (no check).
autoload -U compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh-24) ]]; then
  compinit -C
else
  compinit
fi

# 3. load completions after autocomplete loaded
# make sure those files call out to compdef to register the completion
for file in ${(M)config_files:#*.completion.zsh}
do
  source $file
done

# clean up
unset config_files

export PATH="$HOME/.yarn/bin:$PATH"

eval "$(starship init zsh)"

# fzf: Ctrl-R fuzzy history, Ctrl-T file search, Alt-C cd, ** <Tab> completion
if command -v fzf >/dev/null 2>&1; then source <(fzf --zsh); fi

export GPG_TTY=$(tty)

# Cargo
export PATH="$HOME/.cargo/bin:$PATH"

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

# ASDF (macOS only, see .chezmoiignore)
if command -v asdf >/dev/null 2>&1; then
  export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"
fi


# Load SSH keys (incl. the git signing key) from the macOS Keychain
# Skip when the agent already holds keys (the slow call takes ~0.8s)
ssh-add -l >/dev/null 2>&1 || ssh-add --apple-load-keychain -q 2>/dev/null
